# App
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000

# Database
DATABASE_URL=postgresql://appuser:password@localhost:5432/ticketbox

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay (test mode keys ONLY — live keys are forbidden)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ticketbox-banners

# Logging
LOG_LEVEL=info

# Seed admin (used by knex seed only)
ADMIN_EMAIL=admin@ticketbox.local
ADMIN_PASSWORD=Admin@12345
