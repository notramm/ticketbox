{
  "name": "ticketbox",
  "version": "1.0.0",
  "description": "TicketBox — event/workshop ticket booking (backend + EJS public site)",
  "main": "src/api.js",
  "scripts": {
    "dev:api": "nodemon --watch src --watch .env src/api.js",
    "dev:web": "nodemon --watch src --watch .env --watch public --ext js,ejs,css,json src/web.js",
    "start:api": "node src/api.js",
    "start:web": "node src/web.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "db:setup": "knex migrate:latest && knex seed:run"
  },
  "keywords": [
    "ticketbox",
    "express",
    "knex",
    "razorpay"
  ],
  "author": "Ram",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
